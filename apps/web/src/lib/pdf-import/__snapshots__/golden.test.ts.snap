          {
            "text": "SELECT s.subject, COUNT(*) AS notes, AVG(q.score) AS avg_score FROM notes AS n JOIN subjects AS s ON s.id = n.subject_id LEFT JOIN quizzes AS q ON q.note_id = n.id WHERE n.created_at >= NOW() - INTERVAL '30 days' GROUP BY s.subject",
            "type": "text",
          },
        ],
        "type": "paragraph",
      },
