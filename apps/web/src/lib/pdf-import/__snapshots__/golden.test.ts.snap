            "type": "text",
          },
        ],
        "type": "paragraph",
      },
      {
        "content": [
          {
            "text": "function group<T extends { tags: string[] }>(items: T[]): Map<string, T[]> { const out = new Map<string, T[]>(); for (const it of items) { for (const tag of it.tags) { const bucket = out.get(tag) ?? []; bucket.push(it); out.set(tag, bucket); } } return out; }",
            "type": "text",
          },
        ],
        "type": "paragraph",
