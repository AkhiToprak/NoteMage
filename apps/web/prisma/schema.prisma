// GAMIFICATION: STREAKS
// ============================================================================

model UserStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime? @db.Date
  freezesLeft   Int       @default(2)
  freezesUsed   Int       @default(0)
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// ============================================================================
// GAMIFICATION: ACHIEVEMENTS
// ============================================================================

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  badge      String // unique key: "first_notebook", "100_messages", "30_day_streak", etc.
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
  @@map("achievements")
}

// ----------------------------------------------------------------------------
// UserCosmetic — a row per (user, cosmetic) unlock.
//
// cosmeticId is a stable slug that references an entry in the code-side
// catalog at src/lib/cosmetics/catalog.ts. Deliberately NO foreign key to a
// Cosmetic table — the catalog lives in code so adding a new unlockable is a
// typed, zero-migration change. The tradeoff is that orphaned rows may exist
// if a catalog entry is ever removed; the renderer treats unknown slugs as
// no-ops, so this is safe.
// ----------------------------------------------------------------------------
model UserCosmetic {
  userId     String
  cosmeticId String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cosmeticId])
  @@index([userId])
  @@map("user_cosmetics")
}

// ============================================================================
// EXAMS
// ============================================================================

model Exam {
  id                 String   @id @default(cuid())
  userId             String
  notebookId         String
  title              String // "Biology Final Exam"
  examDate           DateTime
  reminders          Boolean  @default(true)
  // Exam Mode (Phase 0) — the learner's target grade on the 0–100 NEUTRAL scale
  // (see src/lib/grading-systems.ts; display uses User.gradingSystem). Null = no
  // target set. Drives "predicted vs target" on the hub + the post-exam report.
  targetGradeNeutral Float?
  // Exam Mode (Phase 0) — free-form exam-day format ('written' | 'oral' |
  // 'practical' | 'mixed' | …). Null = unspecified. Steers mock-exam defaults.
  format             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook   StudyContainer  @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  // Mage Revolution Phase 5 — what this exam covers (scoped paths / quiz sets /
  // flashcard sets / pages / documents / sections). Drives deriveExamReadiness.
  scopeItems ExamScopeItem[]
  // Exam Mode (Phase 0) — AI/deterministic study plans (one active at a time)
  // and the recorded post-exam result (at most one).
  studyPlans ExamStudyPlan[]
  result     ExamResult?
  // Exam Mode (Phase 3) — timed mock-exam rehearsals run for this exam.
  mocks      MockExam[]

  @@index([userId, examDate])
  @@map("exams")
}

// Mage Revolution Phase 5 — one entry in an exam's coverage scope. A path,
// quiz set, flashcard set, page, document, or section the exam tests. Polymorphic
// by (itemType, itemId); ownership of the referenced row is RE-AUTHORIZED at
// write time (the FK only ties the row to its exam, never to the referenced
// content). `deriveExamReadiness` rolls these up: graded items (paths via
// derivePathStats, quiz sets via best QuizAttempt) drive readiness; passive
// material (flashcards / pages / documents / sections) is lower-weighted.
model ExamScopeItem {
  id        String   @id @default(cuid())
  examId    String
  itemType  String // 'path' | 'quiz_set' | 'flashcard_set' | 'page' | 'document' | 'section'
  itemId    String
  createdAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, itemType, itemId])
  @@index([examId])
  @@map("exam_scope_items")
}

// Mage Revolution Phase 7 — a focused remediation session. The medium-risk
// "generate" Mage actions (weak-topic / exam-sim / manual practice) assemble a
// QuizSet here, point `quizSetId` at it, and launch the EXISTING study-pack quiz
// viewer; attempts flow through the canonical attempt route (zero new grading
// code). `examId` / `sourcePathId` are provenance-only bare columns (no FK) — a
// session survives the exam/path being deleted, matching the plan's model.
model PracticeSession {
  id           String   @id @default(cuid())
  userId       String
  origin       String // 'weak_topic' | 'exam_sim' | 'mistake_review' | 'manual'
  examId       String? // provenance only (exam-sim origin)
  sourcePathId String? // provenance only (weak-topic origin)
  quizSetId    String? // the assembled quiz the learner takes
  status       String   @default("assembling") // 'assembling' | 'ready' | 'completed'
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("practice_sessions")
}

// ============================================================================
// EXAM MODE — study plans + results (Phase 0 foundations)
// ============================================================================

// Exam Mode (Phase 0) — an AI- or deterministically-built study plan for one
// exam. Deliberately named ExamStudyPlan to avoid colliding with the unrelated
// learning-path `StudyPlan` model above. "Today's plan" = items where
// scheduledDate = today; the calendar groups items by date. Regenerating builds
// a fresh row and flips the prior one to `superseded`, so an exam keeps history
// (only one row stays `active`).
model ExamStudyPlan {
  id                 String   @id @default(cuid())
  examId             String
  generatedAt        DateTime @default(now())
  // Days from generation to the exam date the plan was built to cover.
  horizonDays        Int
  // Minutes/day the plan budgets the learner — the daily-time slider input.
  dailyMinutesTarget Int
  // Mage's "Why this plan" explanation, shown on Today's plan + the calendar.
  rationale          String   @db.Text
  status             String   @default("active") // 'active' | 'superseded' | 'archived'
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  exam  Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  items ExamStudyPlanItem[]

  @@index([examId, status])
  @@map("exam_study_plans")
}

// Exam Mode (Phase 0) — one scheduled task in an ExamStudyPlan. `refType`/`refId`
// are a bare polymorphic pointer (no FK) at a slot / activity / quiz set the task
// works through; `weakPoint` / `urgency` / `readinessDelta` let the calendar rank
// tasks and the hub explain their impact.
model ExamStudyPlanItem {
  id             String   @id @default(cuid())
  planId         String
  scheduledDate  DateTime @db.Date // the calendar day this task lands on (date-only)
  // Order within the day. Named sortOrder per the StudyPhase convention; `order`
  // is a SQL reserved word.
  sortOrder      Int      @default(0)
  kind           String // 'theory' | 'flashcards' | 'quiz' | 'mock' | 'review' | 'final_revision'
  title          String
  estMinutes     Int      @default(0)
  status         String   @default("not_started") // 'not_started' | 'in_progress' | 'done'
  refType        String? // slot | activity | quiz_set | path | flashcard_set | …
  refId          String?
  weakPoint      Boolean  @default(false)
  urgency        Int? // higher = more urgent (sort + "urgent" grouping); null = neutral
  readinessDelta Float? // estimated readiness gain (0–100 points) from completing this

  createdAt DateTime @default(now())

  plan ExamStudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, scheduledDate, sortOrder])
  @@map("exam_study_plan_items")
}

// Exam Mode (Phase 0) — the learner's recorded outcome after sitting the exam.
// One per exam (examId unique). `gradeNeutral` is on the 0–100 neutral scale
// (display via User.gradingSystem). `reflection` holds the structured
// what-went-wrong reasons + Mage's take from the bad-result loop. Drives the
// report's predicted-vs-actual and the post-exam archive state.
model ExamResult {
  id             String   @id @default(cuid())
  examId         String   @unique
  gradeNeutral   Float
  outcome        String   @default("pending") // 'passed' | 'failed' | 'pending'
  difficultyFelt String? // 'easy' | 'as_expected' | 'tough' | 'very_hard'; null until asked
  notes          String?  @db.Text
  reflection     Json?
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_results")
}

// Exam Mode (Phase 3) — one timed mock-exam rehearsal. Reuses the existing
// PracticeSession(origin='exam_sim') → QuizSet → canonical QuizAttempt grading
// spine: `practiceSessionId` is the assembly session, `quizSetId` the assembled
// (sealed) set the learner sits, and `quizAttemptId` the graded attempt once
// submitted. `config` carries the setup choices (type quick/full/weakness/final,
// durationSec, questionTypes[], difficulty, hints, topics[], questionCount).
// `readinessBefore`/`readinessAfter` snapshot deriveExamReadiness at create- and
// grade-time so the results screen can show the honest readiness delta. The
// question-navigator flags are ephemeral run-state (no post-submit use) and stay
// client-side — no extra table. All content pointers are bare columns (no FK) so
// a mock survives the underlying set/attempt being pruned.
model MockExam {
  id                String   @id @default(cuid())
  examId            String
  userId            String
  practiceSessionId String?
  quizSetId         String?
  quizAttemptId     String?
  config            Json
  readinessBefore   Float?
  readinessAfter    Float?
  status            String   @default("ready") // 'assembling' | 'ready' | 'in_progress' | 'completed'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, createdAt])
  @@index([userId, createdAt])
  @@map("mock_exams")
}

// ============================================================================
// TODOS
// ============================================================================

model Todo {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.VarChar(200)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@map("todos")
}

// ============================================================================
// USAGE TRACKING
// ============================================================================

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  featureType String // e.g. "ai_flashcards", "ai_pptx", "ai_study_plan", "scholar_chat"
  month       DateTime // First day of the month (UTC)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureType, month])
  @@index([userId, month])
  @@map("usage_records")
}

/// One row per AI model call (chat, path generation, page generation, essay,
/// summarize, inline, classify, …). Written best-effort by logAiUsage() so the
/// admin console can roll up token spend + USD cost across EVERY AI surface, not
/// just chat. Unlike UsageRecord (a per-month feature *count* for quotas), this
/// records actual token counts + computed cost per call. userId is a plain
/// column (no FK) so rows survive account deletion for historical reporting.
model AiUsageEvent {
  id               String   @id @default(cuid())
  userId           String?
  feature          String // 'chat-plain', 'chat-generate', 'path-structure', 'path-generate', 'page-generate', 'essay', …
  provider         String // 'anthropic' | 'gemini' | 'openrouter'
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_events")
}

/// PathGenerationTelemetry — one row per path generation, recording how the
/// figure-reuse pipeline behaved (figure-reuse hardening, P4). Written
/// best-effort at the end of generation; never blocks a path. Lets the admin
/// debug surface answer "why did/didn't figures appear" without re-running.
/// userId is a plain column (no FK) so rows survive account deletion.
model PathGenerationTelemetry {
  id                  String   @id @default(cuid())
  planId              String
  userId              String?
  /// Candidate PageImages loaded before ranking (the bounded pool).
  sourceImageCount    Int      @default(0)
  /// Captioned images actually rendered into the prompt catalog.
  catalogImageCount   Int      @default(0)
  /// Figure refs the model emitted across theory + flashcards + quiz.
  requestedRefs       Int      @default(0)
  /// Refs that validated + resolved to a catalog image (kept).
  acceptedRefs        Int      @default(0)
  /// Refs dropped (sum of `rejections`).
  rejectedRefs        Int      @default(0)
  /// [{ ref, reason }] — reason ∈ unknown_ref | schema_invalid | duplicate | cap_exceeded.
  rejections          Json?
  /// Blobs copied into theory/flashcard/quiz snapshots.
  snapshotCount       Int      @default(0)
  theoryImageCount    Int      @default(0)
  flashcardImageCount Int      @default(0)
  quizImageCount      Int      @default(0)
  /// Set when figures were skipped wholesale: no_source_images | no_catalog_captions | catalog_build_failed.
  skippedReason       String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([planId])
  @@map("path_generation_telemetry")
}

// ============================================================================
// ABUSE PREVENTION
// ============================================================================

/// Tracks every account registration by a salted HMAC of the client IP (the raw
/// address is never stored — see hashIp() in src/lib/registration.ts). Records
/// persist even when the associated account is deleted. Used to enforce a
/// max-accounts-per-IP limit (resets after 12 months).
model IpRegistration {
  id        String   @id @default(cuid())
  ip        String // salted HMAC-SHA256 of the client IP (not the raw address)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("ip_registrations")
}

// 6-digit email-confirmation codes for the credentials-signup gate. The code
// is stored bcrypt-hashed (never plaintext) — a 6-digit space is small, so
// the `attempts` cap + 15-min expiry are what make brute force infeasible.
// One active row per user: reissuing (resend) deletes prior rows first, and a
// successful verify deletes them all.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // bcrypt hash of the 6-digit code
  attempts  Int      @default(0) // wrong-guess counter; row is dead past the cap
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_codes")
}

// Password-reset codes for the forgot-password flow. Field-for-field a clone of
// EmailVerificationCode (6 numeric digits, bcrypt-hashed, 15-min TTL, ≤5
// attempts, one active row per user) but a SEPARATE table so the live signup
// verification path is never touched. See src/lib/verification.ts.
model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // bcrypt hash of the 6-digit code
  attempts  Int      @default(0) // wrong-guess counter; row is dead past the cap
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_codes")
}

// ============================================================================
// WAITLIST
// ============================================================================

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}

// --- Admin Audit Logging ---

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String // e.g. "user.ban", "post.delete"
  targetId  String // ID of the affected resource
  details   String?  @db.Text // Optional JSON details
  createdAt DateTime @default(now())

  // adminId is nullable + SetNull so deleting an admin TOMBSTONES their actions
  // (retains the history with a null actor) instead of cascading the rows away —
  // an actor must not be able to erase their own audit trail by self-deleting.
  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Durable authentication / security-event log (NM3-20). Distinct from
// AdminAuditLog (admin moderation actions) — this captures auth-relevant events
// (login success/failure, lockout, password change, OAuth link/create) for
// incident response + GDPR breach investigation. userId is a plain string (no
// FK) so events survive account deletion for forensics; `type` is a dotted key;
// `detail` is optional JSON.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // e.g. "login.success", "login.failed", "account.locked"
  ip        String? // salted HMAC of the IP, or null
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

// Onboarding-real-generation P4 — anonymous, pre-signup preview state, kept in
// its own table (D3) so anonymous data never touches an owned table. Keyed by
// the httpOnly `nm_anon` cookie (one row per anon session). Holds only the
// KB-sized corpus slice + the generated preview JSON; the heavy PDF bytes stay
// client-side in IndexedDB (D2). Materialized into an owned StudyPlan at claim
// (signup) — the structure is reused verbatim, never regenerated (D8) — then
// marked `claimed`. Unclaimed rows are swept after `expiresAt` (~48h, P5). No
// FKs (claimedByUserId is intentionally not a relation, like Ticket.refId) so
// the table stays isolated; integrity is enforced at the application layer.
// Pure additive — safe to apply on prod.
model PendingOnboardingPath {
  id         String  @id @default(cuid())
  anonToken  String  @unique
  sourceKind String // "upload" | "notes" | "link"
  title      String
  language   String  @default("en")
  goal       String? @db.Text
  intensity  String?

  // The ~10k-char preview slice generation was grounded in (every source kind).
  cappedCorpus String? @db.Text
  // Full text for completion — pasted notes / video transcript. PDF = null: its
  // bytes live client-side, so the full path completes from `cappedCorpus` (the
  // stored slice) or a post-auth re-upload (the "deeper path" nudge, deferred).
  fullText     String? @db.Text

  // Preview artifacts as plain JSON (no owned rows until claim): Stage A
  // structure (PathStructureToolInput), the slot-1 lesson (incl. its TipTap
  // body, attached as theory at claim), and the 2 warm-up questions.
  structureJson        Json
  lessonJson           Json
  previewQuestionsJson Json

  status          String  @default("ready") // "ready" | "claimed"
  claimedByUserId String?
  claimedPlanId   String?

  ipHash    String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("pending_onboarding_paths")
}
