// Exam Mode (Phase 6) — DB-backed notification/reminder preferences, replacing
// the old localStorage-only settings. One row per user; a missing row means
// "all defaults" (opt-in: reminders on, email on). Booleans gate which
// reminders the cron sweep (src/lib/exam-reminders.ts) creates and emails.
model UserNotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Exam countdown — "X is in N days" at 7 / 3 / 1 days before the exam.
  examReminders   Boolean @default(true)
  // Readiness nudges — when an exam is close and the learner is behind on
  // weak topics / readiness is low.
  readinessAlerts Boolean @default(true)
  // Also deliver the above reminders by email (in addition to in-app).
  emailReminders  Boolean @default(true)
  // Marketing / digest channels (UI-managed; no automated sender yet — kept so
  // the preference survives once those features ship).
  productUpdates  Boolean @default(true)
  weeklyReport    Boolean @default(false)
  // Weakness Training Phase 4.4 — master opt-out for the weak-spot nudge
  // system (in-app tile escalation AND the email digest with one flag; a user
  // who doesn't want to be nudged about weak spots wants neither channel).
  weakSpotNudges  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

// ─────────── Weakness Training — Phase 4.4 (nudges + escalation) ───────────
// See plans/weakness-training-phase4.md §14. One WeaknessNudgeLog row per
// DIGEST SEND (never per concept); the [userId, windowKey, channel] unique
// constraint is the dedup guard — a retried sweep collides, never double-sends.

model WeaknessNudgeLog {
  id           String    @id @default(cuid())
  userId       String
  channel      String // 'in_app' | 'email' | 'push' (push unused until 4.4c)
  triggerKinds String[] // union of trigger kinds that fired this digest
  conceptIds   String[] // Concept.id rows included — audit/debug
  windowKey    String // "<userId>:<isoWeek>" (email) / "<userId>:<isoDate>" (in-app)
  // DENORMALISED CACHE (same pattern as ConceptMastery.status): coarse
  // pre-filter only; authoritative resolution is re-derived from activity
  // signals on read.
  state        String    @default("nudged") // nudged | escalated | resolved | expired
  sentAt       DateTime  @default(now())
  resolvedAt   DateTime?

  @@unique([userId, windowKey, channel])
  @@index([userId, sentAt])
  @@index([state])
  @@map("weakness_nudge_logs")
}

model NudgeSweepWatermark {
  id         String    @id @default("singleton") // one row, singleton pattern
  lastRunAt  DateTime?
  lastCursor String? // last-processed userId — resumable pagination mid-sweep
  updatedAt  DateTime  @updatedAt

  @@map("nudge_sweep_watermark")
}

// --- 1.5 Community Posts ---

model Post {
