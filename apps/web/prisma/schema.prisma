// ============================================================================
// USAGE TRACKING
// ============================================================================

model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  featureType String // e.g. "ai_flashcards", "ai_pptx", "ai_study_plan", "scholar_chat"
  month       DateTime // First day of the month (UTC)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureType, month])
  @@index([userId, month])
  @@map("usage_records")
}

/// One row per AI model call (chat, path generation, page generation, essay,
/// summarize, inline, classify, …). Written best-effort by logAiUsage() so the
/// admin console can roll up token spend + USD cost across EVERY AI surface, not
/// just chat. Unlike UsageRecord (a per-month feature *count* for quotas), this
/// records actual token counts + computed cost per call. userId is a plain
/// column (no FK) so rows survive account deletion for historical reporting.
model AiUsageEvent {
  id               String   @id @default(cuid())
  userId           String?
  feature          String // 'chat-plain', 'chat-generate', 'path-structure', 'path-generate', 'page-generate', 'essay', …
  provider         String // 'anthropic' | 'gemini'
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_events")
}

// ============================================================================
// ABUSE PREVENTION
// ============================================================================

/// Tracks every account registration by a salted HMAC of the client IP (the raw
/// address is never stored — see hashIp() in src/lib/registration.ts). Records
/// persist even when the associated account is deleted. Used to enforce a
/// max-accounts-per-IP limit (resets after 12 months).
model IpRegistration {
  id        String   @id @default(cuid())
  ip        String // salted HMAC-SHA256 of the client IP (not the raw address)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("ip_registrations")
}

// 6-digit email-confirmation codes for the credentials-signup gate. The code
// is stored bcrypt-hashed (never plaintext) — a 6-digit space is small, so
// the `attempts` cap + 15-min expiry are what make brute force infeasible.
// One active row per user: reissuing (resend) deletes prior rows first, and a
// successful verify deletes them all.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // bcrypt hash of the 6-digit code
  attempts  Int      @default(0) // wrong-guess counter; row is dead past the cap
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_codes")
}

// Password-reset codes for the forgot-password flow. Field-for-field a clone of
// EmailVerificationCode (6 numeric digits, bcrypt-hashed, 15-min TTL, ≤5
// attempts, one active row per user) but a SEPARATE table so the live signup
// verification path is never touched. See src/lib/verification.ts.
model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // bcrypt hash of the 6-digit code
  attempts  Int      @default(0) // wrong-guess counter; row is dead past the cap
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_codes")
}

// ============================================================================
// WAITLIST
// ============================================================================

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
}

// --- Admin Audit Logging ---

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String // e.g. "user.ban", "post.delete"
  targetId  String // ID of the affected resource
  details   String?  @db.Text // Optional JSON details
  createdAt DateTime @default(now())

  // adminId is nullable + SetNull so deleting an admin TOMBSTONES their actions
  // (retains the history with a null actor) instead of cascading the rows away —
  // an actor must not be able to erase their own audit trail by self-deleting.
  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Durable authentication / security-event log (NM3-20). Distinct from
// AdminAuditLog (admin moderation actions) — this captures auth-relevant events
// (login success/failure, lockout, password change, OAuth link/create) for
// incident response + GDPR breach investigation. userId is a plain string (no
// FK) so events survive account deletion for forensics; `type` is a dotted key;
// `detail` is optional JSON.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String // e.g. "login.success", "login.failed", "account.locked"
  ip        String? // salted HMAC of the IP, or null
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

// ============================================================================
// PATH PUBLISHING & COMMUNITY LIBRARY (Phase 1 of path-publishing plan)
// ============================================================================
//
// Mirrors `SharedNotebook` field-for-field where possible. Diverges only where
// moderation requires extra state (multi-layer audit pipeline, popularity-gated
// pre-translation, rating aggregates). See:
//   plans/path-publishing-community-library.md
//   plans/path-publishing-community-library-p0-spec.md

// A StudyPlan snapshot published to the community library. One current
// publication per plan (re-publish = delete + insert). Snapshots
// language/subjects/phaseCount/slotCount at publish time so later edits to
// the source plan don't retro-mutate the listing.
model SharedPath {
  id                    String    @id @default(cuid())
  planId                String
  sharedById            String
  title                 String
  description           String?   @db.Text
  coverImageUrl         String?
  language              String // BCP-47 lowercase, snapshotted from StudyPlan.language
  subjects              String[]  @default([]) // Snapshotted from StudyPlan.subjects
  phaseCount            Int       @default(0)
  slotCount             Int       @default(0)
  // Moderation state machine (string-enum for compat with existing schema
  // style). Transitions are tracked row-by-row in ModerationAudit.
  // "pending" | "auditing_l2" | "auditing_l3" | "flagged_pending_human"
  //   | "approved" | "rejected"
  moderationStatus      String    @default("pending")
  rejectionReason       String?   @db.Text // Composed from ModerationAudit.reasonCode at terminal reject
  seeded                Boolean   @default(false) // Admin-curated; bypasses L1/L2/L3
  // Author's publish-time choice (theory-visuals feature): when true, the
  // clone flow deep-copies embedded theory images; when false it strips the
  // pathImage nodes from cloned bodies so cloners get no dead image refs.
  includeImages         Boolean   @default(false)
  downloadCount         Int       @default(0)
  viewCount             Int       @default(0)
  // Denormalized rating aggregates — updated atomically inside the
  // transaction that mutates PathRating rows. List endpoints read these
  // directly, no per-row aggregation.
  ratingAverage         Float?
  ratingCount           Int       @default(0)
  approvedAt            DateTime? // Set on transition into "approved"
  // First time a popular-language fan-out fires for this path. Atomic
  // guard so concurrent clones crossing POPULARITY_THRESHOLD collapse to
  // exactly one fan-out. Null = never popularity-gated and never
  // admin-promoted.
  popularityTriggeredAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  plan         StudyPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  sharedBy     User              @relation(fields: [sharedById], references: [id], onDelete: Cascade)
  translations PathTranslation[]
  audits       ModerationAudit[]
  ratings      PathRating[]
  reports      Report[]
  clones       StudyPlan[]       @relation("PathClones")

  @@unique([planId])
  @@index([sharedById])
  @@index([moderationStatus, createdAt])
  @@index([moderationStatus, language, downloadCount(sort: Desc)])
  @@index([approvedAt(sort: Desc)])
  @@index([moderationStatus, ratingAverage(sort: Desc)])
  @@index([seeded, moderationStatus])
  @@map("shared_paths")
}

// (sharedPathId, language) cached translation row. The unique constraint is
// both the read-side cache key and the write-side single-flight lock: the
// translation flow uses `INSERT … ON CONFLICT DO NOTHING; SELECT` so
// concurrent first-requesters collapse to exactly one AI call.
model PathTranslation {
  id               String   @id @default(cuid())
  sharedPathId     String
  language         String // BCP-47 lowercase target code
  status           String   @default("translating") // "translating" | "ready" | "failed"
  title            String?
  description      String?  @db.Text
  // Translated phases/slots/activities/theory/flashcards/quizzes — the full
  // translatable surface. Null while translating, populated atomically on
  // success. Snapshot of SharedPath content at translation time.
  payload          Json?
  error            String?  @db.Text // Set when status="failed"
  provider         String? // Model id (e.g. "gemini-2.5-flash")
  costUsd          Float    @default(0)
  tokensIn         Int      @default(0)
  tokensOut        Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sharedPath SharedPath @relation(fields: [sharedPathId], references: [id], onDelete: Cascade)

  @@unique([sharedPathId, language])
  @@index([sharedPathId])
  @@index([language, createdAt])
  @@index([status, createdAt])
  @@map("path_translations")
}

// Append-only per-layer log of every L1/L2/L3/L4/L5 verdict on a SharedPath.
// L4 (P13) = post-publish reports + trust-gate auto-flag.
model ModerationAudit {
  id               String   @id @default(cuid())
  sharedPathId     String
  layer            Int // 1 | 2 | 3 | 4 | 5
  // Per-layer verdict ranges: L1 "pass"|"reject"; L2 "pass"|"reject"|"flag";
  // L3 "auto_reject"|"escalate_to_human"; L4 "flag"; L5 "pass"|"reject".
  verdict          String
  // Taxonomy: "wordlist.<lang>.<category>" | "l2.<category>"
  //   | "l3.<category>" | "l4.reports" | "l4.untrusted_author"
  //   | "l5.<category>"
  // Categories: adult, hateful, spam, offtopic, low_quality, copyright, other.
  reasonCode       String?
  reasoning        String?  @db.Text // Model output (L2/L3) or admin note (L5)
  actorId          String? // Set for L5; null for L1/L2/L3
  model            String? // Model id when L2/L3
  costUsd          Float    @default(0)
  tokensIn         Int      @default(0)
  tokensOut        Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  sharedPath SharedPath @relation(fields: [sharedPathId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([sharedPathId, createdAt])
  @@index([layer, verdict, createdAt])
  @@index([actorId])
  @@map("moderation_audits")
}

// 1..5 rating of a SharedPath. Mirrors NotebookRating; one rating per
// (user, path) via the unique constraint. Aggregates on SharedPath are
// updated atomically in the same transaction as inserts/updates/deletes.
model PathRating {
  id           String   @id @default(cuid())
  sharedPathId String
  userId       String
  value        Int // 1..5; check constraint added in the migration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sharedPath SharedPath @relation(fields: [sharedPathId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedPathId, userId])
  @@index([sharedPathId])
  @@map("path_ratings")
}

// Path-publishing Layer 4 (P13) — a community report against an approved
// SharedPath. One report per (user, path) via the unique constraint
// (the spam upper-bound, same shape as PathRating). When the distinct
// count of `open` reports on an approved, non-seeded path crosses
// REPORT_REMODERATION_THRESHOLD, `runReportAggregation` pulls the path
// back to `flagged_pending_human` and opens a moderation_review ticket —
// the post-publish recovery net for content the L1/L2/L3 pipeline let
// through. Resolved by the human-review (L5) outcome: approve →
// `dismissed`, reject → `actioned`.
model Report {
  id           String   @id @default(cuid())
  sharedPathId String
  reporterId   String
  // Moderation category taxonomy (mirrors L2/L3/L5):
  // adult | hateful | spam | copyright | offtopic | low_quality | other.
  reason       String
  detail       String?  @db.Text // Optional reporter note (capped in the API).
  status       String   @default("open") // "open" | "actioned" | "dismissed"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sharedPath SharedPath @relation(fields: [sharedPathId], references: [id], onDelete: Cascade)
  reporter   User       @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([sharedPathId, reporterId])
  @@index([sharedPathId, status])
  @@index([status, createdAt])
  @@map("reports")
}

// Generic human-actionable work item. v1 ships only type=moderation_review
// (L3 escalations). refType/refId is intentionally not a FK so the table
// stays generic; integrity is enforced at the application layer (open
// tickets auto-dismiss when the referenced SharedPath is deleted).
model Ticket {
  id             String    @id @default(cuid())
  type           String // v1: "moderation_review"
  refType        String // v1: "SharedPath"
  refId          String
  status         String    @default("open") // "open" | "assigned" | "resolved" | "dismissed"
  assigneeId     String?
  resolvedById   String? // Distinct from assignee (may be a different admin)
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignee   User? @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ResolvedTickets", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([refType, refId])
  @@index([assigneeId, status])
  @@index([type, status])
  @@map("tickets")
}
