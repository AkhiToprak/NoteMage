// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Tier {
  FREE
  PRO
}

// Quota reset cadence for a paid tier. Only `weekly` changes behaviour: it
// resets usage every week with a ~1/4 allowance (see tiers.ts PRO_WEEKLY_*),
// so a weekly subscriber can't drain a full month's COGS for one week's price.
// monthly + yearly are quota-identical (both reset monthly) — yearly is
// recorded as `monthly`. Null = no weekly plan → monthly semantics.
enum BillingInterval {
  weekly
  monthly
  yearly
}

// Which payment provider currently backs a user's tier. Mirrors the
// Entitlement.source union in packages/shared/src/bridge.ts exactly, so
// /api/me/entitlement maps the DB column straight onto the shared shape.
enum EntitlementSource {
  APPLE_IAP // iOS in-app purchase via RevenueCat / StoreKit
  PADDLE // web + desktop checkout (Merchant of Record)
  LEMON_SQUEEZY // kept for parity with the shared union; unused for now
  MANUAL // admin grants / comps
}

// Question kinds for QuizQuestion.kind — added in Phase 1 (Question Engine v2).
// Schema mirrors packages/shared/src/quiz.ts QUESTION_KINDS exactly.
// Phase 1 ships only `mc` end-to-end; Phase 2A/2B agents wire the rest.
enum QuestionKind {
  mc
  true_false
  fill_blank
  word_bank
  match_pairs
  sentence_reorder
  equation
  translation
  code_output
  timeline
  code_write
  // Path-diagrams revival (Phase 5): deterministic "what's missing in this
  // diagram?" question built in code from a quiz set's structured `diagrams`
  // (zero AI tokens, NEVER LLM-emitted). See QUESTION_KINDS in
  // packages/shared/src/quiz.ts.
  diagram_cloze
}

// Gate strategy for a StudyPhase — added in Phase 5 (Learn Path rework).
// open       = all materials in this phase unlocked from the start.
// sequential = materials in this phase unlock one at a time by sortOrder.
// checkpoint = sequential + the last material gates the next phase.
enum GateStrategy {
  open
  sequential
  checkpoint
}

// ============================================================================
// USER MODELS
// ============================================================================

model User {
  id                         String             @id @default(cuid())
  email                      String             @unique
  name                       String?
  password                   String? // Hashed with bcrypt; null for OAuth-only accounts
  // Email-confirmation gate for credentials sign-ups. Null = not yet
  // verified → CredentialsProvider.authorize() refuses login (hard block).
  // OAuth accounts are provider-verified, so they're stamped on create.
  // Pre-existing rows were grandfathered (set to createdAt) in the
  // add_email_verification migration so only new signups are gated.
  emailVerified              DateTime?
  role                       String             @default("user") // "user" | "admin"
  authVersion                Int                @default(1) // Increment to revoke every existing JWT for this user
  banned                     Boolean            @default(false) // Banned users cannot log in
  banReason                  String? // Optional reason shown to banned user
  failedLoginAttempts        Int                @default(0) // Brute-force protection counter
  lockedAt                   DateTime? // Set when account is locked after too many failures
  dailyGoal                  Int                @default(10) // Pages the user wants to write/study per day (kept for backward compat)
  // Personal targets — null = not set
  dailyStudyMinutesGoal      Int?
  weeklyStudyPlansGoal       Int?
  weeklyNotesGoal            Int?
  weeklyChatsGoal            Int?
  username                   String             @unique // 3-20 chars, alphanumeric + underscores only
  avatarUrl                  String? // URL to uploaded avatar image, null = default
  bio                        String?            @db.VarChar(160) // Short bio, max 160 chars
  age                        Int?
  birthDate                  DateTime?          @db.Date // Date of birth — collected at sign-up for the 13+ age gate
  location                   String?            @db.VarChar(100)
  school                     String?            @db.VarChar(100)
  lineOfWork                 String?            @db.VarChar(100)
  fieldOfStudy               String?            @db.VarChar(100) // What the user studies — set in the onboarding personalization step
  gradingSystem              String?            @db.VarChar(20) // Grading-system id (see src/lib/grading-systems.ts); set in onboarding, editable in settings; null = not chosen yet
  instagramHandle            String?            @db.VarChar(30) // Public IG username (no @), shown on Socials bento card
  linkedinUrl                String?            @db.VarChar(200) // Full LinkedIn profile URL, shown on Socials bento card
  customGreeting             String?            @db.VarChar(120) // Custom dashboard greeting, null = use random
  scholarName                String?            @db.VarChar(30) // Custom AI assistant name, null = "Scholar"
  usernameChanged            Boolean            @default(false) // Set to true when user changes their username
  profilePrivate             Boolean            @default(false) // If true, only friends see full profile
  hideAchievements           Boolean            @default(false) // If true, achievements hidden on public profile
  quizReactionsMode          String             @default("all") // "all" | "minimal" | "off" — Phase 3 mascot reaction engine
  quizReactionsAudio         Boolean            @default(false) // Opt-in sound effects for quiz reactions
  // Phase 7 — personal learning-path rework achievement stats. Denormalized
  // so achievement gathering reads a single column instead of replaying
  // every QuizAttempt.answers blob. Bumped by the attempts route.
  maxQuizStreakEver          Int                @default(0) // Longest consecutive-correct run in any single quiz session
  everHadComeback            Boolean            @default(false) // Has the user ever, in one session, hit ≥3 wrong then ≥5 right?
  tier                       Tier               @default(FREE)
  pendingTier                Tier? // Tier to switch to at end of current period (null = no change)
  billingInterval            BillingInterval? // Quota reset cadence (null = monthly). Only `weekly` diverges — see tiers.ts
  subscriptionPeriodEnd      DateTime? // When the current billing period ends (null = free / no active period)
  // Which provider currently backs `tier`. Null when FREE. Drives the
  // `source` field of /api/me/entitlement (see src/lib/entitlement.ts).
  entitlementSource          EntitlementSource? // null = FREE / no active source
  inGracePeriod              Boolean            @default(false) // dunning / billing-retry window — keep PRO, don't downgrade yet
  // Lemon Squeezy (web/desktop, Merchant of Record).
  lemonSqueezyCustomerId     String?            @unique
  lemonSqueezySubscriptionId String?            @unique
  // RevenueCat / Apple IAP (iOS). revenueCatAppUserId is set to User.id on
  // logIn so the StoreKit purchase binds to this account; the Apple
  // originalTransactionId is the stable per-Apple-account key used for
  // idempotent restore/transfer handling.
  revenueCatAppUserId        String?            @unique
  appleOriginalTransactionId String?            @unique
  // 7-day free trial (no card). Set at signup by trialGrant() (src/lib/entitlement.ts):
  // tier=PRO + billingInterval=weekly + trialEndsAt=now+7d. When trialEndsAt passes with
  // no paid subscription, the dashboard AccountGate flips tier→FREE and shows the "trial
  // ended" gate (subscribe or pause). Null = never trialed (comped / legacy grandfathered).
  trialEndsAt                DateTime?
  // Set when the user chooses "Pause my account" at trial end. Locks the account into the
  // paused screen (escapable only by subscribing) and starts the 3-month retention clock —
  // the deletion sweep hard-deletes at pausedAt + 90d. Cleared on resubscribe by
  // activeGrant(). Null = not paused.
  pausedAt                   DateTime?
  // One-shot flag set true by activeGrant() ONLY on the transition into paid, consumed once
  // by the AccountGate to show the "You're in!" success screen after payment settles.
  pendingWelcome             Boolean            @default(false)
  onboardingComplete         Boolean            @default(false) // false until wizard step 4 is done
  // Welcome tour state — { step: TutorialStep, completedAt?: ISO, dismissedAt?: ISO }
  tutorialState              Json               @default("{}")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  // Core relations
  notebooks    StudyContainer[]
  chatMessages ChatMessage[]

  // Phase 1 — Social relations
  sentFriendRequests      Friendship[]                 @relation("SentFriendRequests")
  receivedFriendRequests  Friendship[]                 @relation("ReceivedFriendRequests")
  notifications           Notification[]
  // Exam Mode (Phase 6) — DB-backed notification/reminder preferences. At most
  // one row per user; absence means "all defaults" (opt-in model). See
  // src/lib/notification-preferences.ts.
  notificationPreferences UserNotificationPreferences?
  posts                   Post[]
  postVotes               PostVote[]
  postComments            PostComment[]
  commentVotes            CommentVote[]
  pollVotes               PollVote[]
  postVisibility          PostVisibility[]
  sharedByMe              SharedNotebook[]             @relation("SharedByMe")
  sharedWithMe            SharedNotebook[]             @relation("SharedWithMe")
  notebookDownloads       NotebookDownload[]
  friendActivities        FriendActivity[]
  lastSeenAt              DateTime?
  microsoftConnection     MicrosoftConnection?
  studyMinutes            StudyMinute[]
  streak                  UserStreak?
  achievements            Achievement[]
  // Cosmetics — see src/lib/cosmetics/catalog.ts for the canonical list.
  // nameStyle is denormalized so username rendering never needs a join.
  // Shape: { fontId?: string, colorId?: string } — both reference catalog slugs.
  nameStyle               Json?
  equippedTitleId         String?
  equippedFrameId         String?
  equippedBackgroundId    String?
  // Admin-only escape hatch: URL of a GIF/image uploaded by the admin that
  // overrides the catalog-based profile background. If set AND the user has
  // role = "admin", ProfileBackground renders this image as-is. Writes are
  // gated to admin accounts inside /api/user/profile and the upload endpoint.
  customBackgroundUrl     String?
  cosmetics               UserCosmetic[]
  exams                   Exam[]
  todos                   Todo[]
  usageRecords            UsageRecord[]
  adminAuditLogs          AdminAuditLog[]              @relation("AdminAuditLogs")
  oauthAccounts           OAuthAccount[]
  // Phase 10 — renamed from checkpointAttempts (CheckpointAttempt was dropped
  // and replaced by AssessmentAttempt scoped to CheckpointSlot).
  assessmentAttempts      AssessmentAttempt[]
  // Phase 9 — direct ownership for detached learn surfaces (paths,
  // flashcards, quizzes, chats); these can live without a notebook now.
  notebookChats           NotebookChat[]
  flashcardSets           FlashcardSet[]
  quizSets                QuizSet[]
  studyPlans              StudyPlan[]
  importJobs              ImportJob[]
  // Mage Revolution Phase 7 — focused remediation sessions (weak-topic /
  // exam-sim / mistake-review / manual). Each assembles a QuizSet the learner
  // takes through the canonical attempt route.
  practiceSessions        PracticeSession[]
  // Email-confirmation codes for the credentials-signup gate (one active
  // row per user; reissued on resend).
  emailVerificationCode   EmailVerificationCode?
  // Password-reset codes for the forgot-password flow (one active row per
  // user; reissued on each request — see src/lib/verification.ts).
  passwordResetCode       PasswordResetCode?

  @@map("users")
}

// Linked OAuth/SSO accounts (Google, Apple, ...). One User may have many.
// Silent same-email linking is gated by `User.password == null || !onboardingComplete`
// in the NextAuth signIn callback — see src/auth/config.ts.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "apple"
  providerAccountId String
  // Token columns kept nullable for future API access (e.g. Drive import) — cheap insurance.
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  idToken           String?  @db.Text
  scope             String?
  tokenType         String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Idempotency ledger for billing webhooks (Paddle + RevenueCat). Each provider
// event carries a stable id; we record it on first processing and no-op on
// replay so duplicate or out-of-order deliveries can't double-apply a change
// or clobber newer subscription state. See app/api/billing/*/webhook/route.ts.
model WebhookEvent {
  provider   String // "paddle" | "revenuecat"
  eventId    String // provider's stable event id (Paddle event_id / RevenueCat id)
  eventType  String? // for debugging / audit
  receivedAt DateTime @default(now())

  @@id([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model BackgroundJob {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("queued") // queued|running|succeeded|failed
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?   @db.Text
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
  @@index([kind, status])
  @@map("background_jobs")
}

// ============================================================================
// NOTEBOOK & DOCUMENT MODELS
// ============================================================================

model StudyContainer {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  subject     String? // e.g., "Biology", "History"
  color       String? // Hex color for UI
  // Phase 9 — "standard" is a user-created notebook; "inbox" is the hidden
  // per-user notebook that backs ad-hoc chat uploads. Exactly one inbox per
  // user; created lazily by getOrCreateInboxNotebook(userId).
  kind        String   @default("standard")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  chatMessages  ChatMessage[]
  chats         NotebookChat[]
  sections      Section[]
  shares        SharedNotebook[]
  flashcardSets FlashcardSet[]
  quizSets      QuizSet[]
  studyPlans    StudyPlan[]
  exams         Exam[]
  importJobs    ImportJob[]

  @@index([userId])
  @@map("notebooks")
}

model ImportJob {
  id                String         @id @default(cuid())
  notebookId        String
  sectionId         String? // PDF target section; null for OneNote (worker creates many sections)
  userId            String
  sourceFormat      String         @default("pdf") // "pdf" | "onenote" | "video"
  fileName          String
  engine            String         @default("") // PDF engine at submission ("gemini-flash-lite" / "text-layer"); OneNote uses "onenote-html"; video uses "gemini-flash" (model token from resolveModel)
  mode              String         @default("rich") // "rich" (vision) | "fast" (text-layer only, P5 of the cost-reduction plan)
  pageTitle         String? // PDF only: user-chosen title for the created page; null = derive from fileName
  pageCap           Int
  status            String         @default("queued") // queued|processing|ready|failed
  progress          Json? // { phase, totalPages, processedPages, message }
  error             String?        @db.Text
  pdfPath           String? // PDF only
  pageImagePaths    Json? // PDF only: string[] temp-imports/ paths
  oneNoteSectionIds Json? // OneNote only: string[] of selected section ids
  videoPath         String? // Video only: temp-imports/ path for an uploaded video file
  videoUrl          String? // Video only: YouTube URL ingested via Gemini fileData.fileUri
  videoDurationSec  Int? // Video only: probed/estimated duration; drives the minutes meter
  mediaResolution   String?        @default("low") // Video only: "low" | "default" — token-rate control
  resultPageId      String?
  resultSummary     Json? // OneNote: { sectionsImported, pagesImported, errors[], firstSectionId?, firstPageId? }
  truncated         Boolean        @default(false)
  fallbackPages     Int            @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  notebook          StudyContainer @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@index([userId, status])
  @@map("import_jobs")
}

model Document {
  id          String   @id @default(cuid())
  notebookId  String
  fileName    String
  filePath    String // Local or S3 path
  fileSize    Int // In bytes
  fileType    String // e.g., "application/pdf"
  textContent String? // Extracted text for LLM context
  createdAt   DateTime @default(now())

  // Relations
  notebook StudyContainer @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@map("documents")
}

// Citation provenance (Mage Revolution P3) — forward-looking char-range
// provenance. Maps a region of a source Document (page + optional character
// span) so a future importer can pin a citation chip to an exact passage,
// not just a page number. Nothing populates this in P3; it is additive
// scaffolding the source-resolution layer (P4) and a precision-aware importer
// will fill in later.

// ============================================================================
// CHAT & CONVERSATION MODELS
// ============================================================================

model NotebookChat {
  id                 String   @id @default(cuid())
  // Phase 9 — userId is the source of truth for ownership; notebookId is the
  // primary/home notebook (may be null for cross-notebook or inbox-only chats).
  userId             String
  notebookId         String?
  title              String   @default("New Chat")
  contextPageIds     String[] @default([]) // Page IDs from any user-owned notebook fed as context
  contextDocIds      String[] @default([]) // Document IDs fed as context
  // Phase 9 — every notebook this chat draws context from (including primary).
  // Used for sidebar grouping and quick "show all chats touching notebook X".
  contextNotebookIds String[] @default([])
  // Mage Revolution Phase 10 — the surface this thread belongs to, so the global
  // panel resumes one persistent conversation per context: 'exam:{id}' >
  // 'path:{id}' > 'notebook:{id}' > 'global' (see `mageContextKey`). Null on
  // legacy notebook chats until backfilled ('notebook:{id}' / 'global').
  contextKey         String?
  // Mage consent grants (thread-level, sticky per conversation). Default false =
  // ask-first: Mage answers from materials only until the learner grants more.
  allowWebSearch        Boolean  @default(false)
  allowGeneralKnowledge Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook      StudyContainer? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]
  flashcardSets FlashcardSet[]
  quizSets      QuizSet[]

  @@index([userId])
  @@index([notebookId])
  // Mage panel resume looks up the latest thread for (user, contextKey).
  @@index([userId, contextKey])
  @@map("notebook_chats")
}

model ChatMessage {
  id         String   @id @default(cuid())
  // Phase 9.6 — nullable so cross-notebook / inbox-only chats can omit a
  // primary notebook. On notebook delete, messages survive (their chat may
  // span others).
  notebookId String?
  userId     String
  chatId     String? // Link to a specific chat session
  role       String // "user" or "assistant"
  content    String // The message text
  tokens     Int? // Number of tokens used (for cost tracking)
  // Mage Revolution Phase 10 — per-message sidecar for global-panel turns:
  // resolved source chips, sourceMode, action cards, reveal gate, answer mode.
  // Null on plain chat messages (and all legacy rows) → the panel renders plain
  // prose. Shape: see `MageMessageMetadata` in src/lib/mage-types.ts.
  metadata   Json?
  createdAt  DateTime @default(now())

  // Relations
  notebook StudyContainer? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat     NotebookChat?   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@index([userId, createdAt])
  @@index([chatId])
  @@map("chat_messages")
}

// ============================================================================
// FLASHCARD MODELS
// ============================================================================

model FlashcardSet {
  id           String   @id @default(cuid())
  // Phase 9 — see NotebookChat for the userId/notebookId rationale.
  userId       String
  notebookId   String?
  chatId       String?
  messageId    String? // assistant message that created this set
  title        String
  source       String   @default("ai") // "ai" | "manual" | "import" | "quizlet" | "anki"
  sectionId    String? // optional: link to a notebook section for publishing
  // Detach path-generated sets from notebook surfaces. StudyContainer list
  // endpoints (`/api/notebooks/[id]/flashcard-sets`, `/inventory`) filter
  // `sourcePathId: null` so a path's generated bundles only show up in
  // the path itself; the FK to StudyPlan is the back-reference the future
  // "Save to notebook" promote action will clear. Path-generated rows
  // still set `notebookId` because FlashcardViewer URL-templates it into
  // every fetch and cannot run without one.
  sourcePathId String?
  // Path-diagrams revival (Phase 3): PathDiagram[] copied (zero AI tokens) from
  // the covering theory's body, rendered by the checkpoint viewer as a collapsed
  // reference panel above the card stack. Set-level (slot-scoped reference
  // graphics, not per-card illustrations). Null/absent when no diagrams apply.
  diagrams     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook           StudyContainer?     @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  chat               NotebookChat?       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  section            Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sourcePath         StudyPlan?          @relation("PathFlashcardSets", fields: [sourcePathId], references: [id], onDelete: SetNull)
  flashcards         Flashcard[]
  // Phase 10 — back-relation for the unique FK on CheckpointActivity. Null
  // for any set not owned by a checkpoint activity.
  checkpointActivity CheckpointActivity?

  @@index([userId])
  @@index([notebookId])
  @@index([chatId])
  @@index([sectionId])
  @@index([sourcePathId])
  @@map("flashcard_sets")
}

model Flashcard {
  id                 String    @id @default(cuid())
  flashcardSetId     String
  question           String
  answer             String    @db.Text
  // Source-highlighting feature — denormalized grounding anchor (parity with
  // QuizQuestion). `sourceQuote` is the passage the source viewer highlights;
  // identity is server-resolved from the corpus at generation time. All
  // nullable so legacy cards and unresolvable anchors fall back gracefully.
  sourceLabel        String? // Citation label, e.g. the document / page title
  sourcePage         Int? // 1-based source page/slide, when known
  sourceQuote        String?   @db.Text // Verbatim grounding passage to highlight
  sourceMaterialId   String? // Page.id or Document.id the quote came from
  sourceMaterialKind String? // "page" | "document"
  sourceTimestampSec Int? // video seek target (seconds)
  sortOrder          Int       @default(0)
  // Spaced repetition fields (SM-2 algorithm)
  easeFactor         Float     @default(2.5)
  interval           Int       @default(0) // days until next review
  repetitions        Int       @default(0) // consecutive correct answers
  nextReviewAt       DateTime? // null = never reviewed
  lastReviewAt       DateTime?
  // Weakness Training Phase 4.3 (plans/weakness-training-phase4.md §13) —
  // leech counter: increments only when a card resets from repetitions >= 2
  // ("Again" after graduating the learning steps); >= 4 flags a leech, which
  // is surfaced as a re-read suggestion, never removed from rotation.
  lapses             Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  flashcardSet FlashcardSet     @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  images       FlashcardImage[]

  @@index([flashcardSetId])
  @@index([nextReviewAt])
  @@map("flashcards")
}

model FlashcardImage {
  id                String   @id @default(cuid())
  flashcardId       String
  // Provenance — which source PageImage this figure was snapshotted from (parity
  // with TheoryImage/QuizQuestionImage). Nullable so source deletion can't strand
  // us and manually-uploaded card images leave it null.
  sourcePageImageId String?
  side              String // "front" | "back"
  fileName          String
  filePath          String
  fileSize          Int
  mimeType          String
  // Slot-local caption for path-generated figures (figure-reuse feature). Null
  // for manually-uploaded flashcard images, which carry no AI caption.
  caption           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId])
  @@map("flashcard_images")
}

// ============================================================================
// QUIZ MODELS
// ============================================================================

model QuizSet {
  id                      String   @id @default(cuid())
  // Phase 9 — see NotebookChat for the userId/notebookId rationale.
  userId                  String
  notebookId              String?
  chatId                  String?
  messageId               String? // assistant message that created this set
  title                   String
  sectionId               String? // optional: link to a notebook section
  // See FlashcardSet.sourcePathId — same rationale (filter from notebook
  // surfaces, keep `notebookId` for QuizViewer routing).
  sourcePathId            String?
  // Path-diagrams revival (Phase 3): PathDiagram[] copied (zero AI tokens) from
  // the covering theory's body, rendered by the checkpoint quiz viewer as a
  // collapsed reference panel above the question list. See FlashcardSet.diagrams.
  diagrams                Json?
  // Prompt/model provenance for generated quizzes. Nullable for legacy and
  // manually-authored sets. Verification details are compact per-item issue
  // records from the sampled/final-exam quality gate.
  generationPromptVersion String?
  generationProvider      String?
  generationModel         String?
  verificationStatus      String?
  verificationModel       String?
  verificationDetails     Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook           StudyContainer?     @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  chat               NotebookChat?       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  section            Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sourcePath         StudyPlan?          @relation("PathQuizSets", fields: [sourcePathId], references: [id], onDelete: SetNull)
  questions          QuizQuestion[]
  attempts           QuizAttempt[]
  // Phase 10 — back-relation for the unique FK on CheckpointActivity.
  checkpointActivity CheckpointActivity?

  @@index([userId])
  @@index([notebookId])
  @@index([chatId])
  @@index([sectionId])
  @@index([sourcePathId])
  @@map("quiz_sets")
}

model QuizQuestion {
  id                 String       @id @default(cuid())
  quizSetId          String
  // Phase 1: `kind` discriminates the question type; existing MC rows backfill
  // to 'mc' via the migration default. `payload` carries kind-specific data
  // for new (non-MC) questions; MC rows stay on the legacy `options` +
  // `correctIndex` columns until the Phase 7 backfill ports them and drops
  // the legacy columns.
  kind               QuestionKind @default(mc)
  payload            Json?
  question           String
  options            String[] // Array of 4 answer choices (legacy MC; see kind/payload above)
  correctIndex       Int // 0-based index of the correct answer (legacy MC)
  hint               String? // Optional hint text
  correctExplanation String?      @db.Text // Shown when answer is correct
  wrongExplanation   String?      @db.Text // Shown when answer is wrong
  // Source provenance (Phase D) — denormalized grounding so the quiz player's
  // "Show source" reader drawer can highlight the exact passage a question was
  // community-cloned paths and raw-text paths have no live source row, and the
  // quote is what we highlight regardless. All nullable — older rows, the
  // code-generated diagram_cloze, and questions the model couldn't ground stay
  // null and the player falls back to the path-level source. `sourcePage` is the
  // approximate 1-based source page (only set for page-imported materials).
  sourceLabel        String? // Citation label, e.g. the document / page title
  sourcePage         Int? // 1-based source page/slide, when known
  sourceQuote        String?      @db.Text // Verbatim grounding passage to highlight
  // Source-highlighting feature — stable identity + media seek so the source
  // viewer can open the ORIGIN material (not just re-print the quote). Resolved
  // server-side from the in-memory corpus at generation time (the model never
  // echoes an id). All nullable: legacy rows and unresolvable labels stay null
  // and the viewer falls back to the quote-only drawer / Mage.
  sourceMaterialId   String? // Page.id or Document.id the quote came from
  sourceMaterialKind String? // "page" | "document"
  sourceTimestampSec Int? // video seek target (seconds), for video-grounded items
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  quizSet QuizSet            @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
  // Figure-reuse (P4) — at most one snapshotted exhibit image per question.
  image   QuizQuestionImage?

  @@index([quizSetId])
  @@map("quiz_questions")
}

// Path-owned snapshot of a source image embedded as a quiz question's exhibit
// (figure-reuse feature, P4). Mirrors TheoryImage: the blob is COPIED at
// generation time (not referenced) so the question survives source-page
// deletion, and the community-clone flow deep-copies these rows by blob
// reference. `questionId` is UNIQUE — one exhibit per question — so the
// renderer/clone/walkers treat it as a 0-or-1 relation, never an array.
model QuizQuestionImage {
  id                String   @id @default(cuid())
  questionId        String   @unique
  sourcePageImageId String? // provenance only; nullable so source deletion can't strand us
  fileName          String
  filePath          String
  fileSize          Int
  mimeType          String
  caption           String?
  createdAt         DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_question_images")
}

model QuizAttempt {
  id         String   @id @default(cuid())
  quizSetId  String
  userId     String
  score      Int
  total      Int
  percentage Float
  timeSpent  Int?
  createdAt  DateTime @default(now())

  quizSet QuizSet      @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizSetId])
  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  selectedIdx Int // Legacy MC; sentinel 0 for non-MC kinds. Real answer lives in userAnswer.
  userAnswer  Json? // Kind-aware answer payload (Phase 2). Null for pre-Phase-2 attempts.
  isCorrect   Boolean
  createdAt   DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("quiz_answers")
}

// ============================================================================
// SECTION & PAGE MODELS (OneNote-style notebook content)
// ============================================================================

model Section {
  id         String   @id @default(cuid())
  notebookId String
  parentId   String? // null = top-level section; set = subsection
  title      String
  sortOrder  Int      @default(0)
  color      String? // Optional accent color override
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  notebook      StudyContainer @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  parent        Section?       @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Section[]      @relation("SectionTree")
  pages         Page[]
  flashcardSets FlashcardSet[]
  quizSets      QuizSet[]

  @@index([notebookId])
  @@index([parentId])
  @@map("sections")
}

model Page {
  id              String   @id @default(cuid())
  sectionId       String
  title           String   @default("Untitled")
  pageType        String   @default("text") // "text" (TipTap editor) | "canvas" (infinite canvas)
  content         Json? // TipTap JSON document format (text pages) or canvas state JSON (canvas pages)
  textContent     String? // Plain text mirror for AI context + search
  drawingData     Json? // Array of stroke objects [{points, color, width}]
  sortOrder       Int      @default(0)
  sourceDocId     String? // Set if this page was imported from a Document
  // Citation provenance (Mage Revolution P3). The 1-based source PDF page
  // where this imported page's content begins — cheap v1 page-number citation
  // a source chip can render as "Biology.pdf · page 7". Null for pages not
  sourceDocPage   Int? // 1-based start page of the imported PDF content
  // Source-highlighting feature — durable video origin for video-imported pages.
  // The YouTube URL lives on the ephemeral ImportJob ledger; denormalized here so
  // the source viewer can embed + seek without a reverse join. Null for non-video
  // pages. `sourceMediaType` distinguishes a seekable YouTube embed from an
  // uploaded file (whose blob is temp-only — viewer degrades to transcript).
  sourceVideoUrl  String? // durable origin URL (YouTube) for video-derived pages
  sourceMediaType String? // "youtube" | "upload"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  section Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  images  PageImage[]

  @@index([sectionId])
  @@map("pages")
}

model PageImage {
  id          String    @id @default(cuid())
  pageId      String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  aiCaption   String? // Vision-generated caption, cached so each image is captioned once (path theory visuals)
  captionedAt DateTime?
  // Provenance (figure-reuse hardening). Normalized crop box [x0,y0,x1,y1] in
  // 0–1 page fractions — set only for vision crops where geometry is known; null
  // for binary-scan / manual / pptx / onenote images. sourceType records HOW the
  // image entered: 'vision_crop' | 'embedded_scan' | 'manual_upload' | 'pptx' |
  // 'onenote'. Both nullable so historical rows are unaffected.
  bbox        Json?
  sourceType  String?
  createdAt   DateTime  @default(now())

  // Relations
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_images")
}

// ----------------------------------------------------------------------------
//
// Written by the PUT /pages/[pageId] handler on every successful content
// update. Kept at ~50 most-recent-per-page by a trigger (see migration).
// Exists for two reasons:
//   1. Instant recovery if content is ever wiped (re-insert the last good
//      row's content back into pages.content).
//   2. Future product feature: user-facing version history / undo.
// Snapshots are stored as JSONB so they compress well and indexing stays
// cheap. Retention bounds total storage: 50 revisions * N pages.
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
//
// Written by the PUT /pages/[pageId] handler BEFORE the actual update, so
// every attempted write is captured — successful or not. Includes client
// request metadata (IP, user-agent) so that if a rogue write ever reaches
// the DB we can trace it back to the exact session within seconds.
//
// `result` is 'accepted' | 'refused_empty_overwrite' | 'error'. Failed
// writes are logged too — that's the whole point.
// ----------------------------------------------------------------------------

// ============================================================================
// PHASE 1 — SOCIAL FEATURE MODELS
// ============================================================================

// --- Study Planning ---

model StudyPlan {
  id                 String   @id @default(cuid())
  // Phase 9 — see NotebookChat for the userId/notebookId rationale. A path may
  // draw materials from multiple notebooks; contextNotebookIds tracks them.
  userId             String
  notebookId         String?
  title              String
  description        String?  @db.Text
  // The learner's own goals / intent message for this path (the "Study goals"
  // brief from setup, or the manual tab's description + section hints). Stage A
  // already used it to shape the structure; persisted so Stage B reads it back
  // and the requested tone / emphasis / focus / difficulty steer the actual
  // theory, flashcards, and quizzes — not just the curriculum skeleton.
  learnerBrief       String?  @db.Text
  startDate          DateTime
  endDate            DateTime
  source             String   @default("manual") // "manual" | "ai"
  contextNotebookIds String[] @default([])
  // Phase 10 — exact material ids (pages / docs / flashcard + quiz sets) the
  // learner picked as source content. Persisted so Stage B can rebuild the
  // same material corpus the structure call was grounded in.
  materialIds        String[] @default([])
  // Phase 10 — AI generation lifecycle for checkpoint bundles. POST returns
  // immediately with status="generating"; the orchestrator (Phase 10.2) flips
  // it to "ready" once every slot has its theory/flashcards/quiz, or "failed"
  // with a message in generationError. The /generation SSE endpoint tails
  // generationProgress (`{ totalSlots, completedSlots, currentSlot,
  // currentActivity }`).
  generationStatus   String   @default("ready") // "queued" | "generating" | "ready" | "failed"
  generationProgress Json?
  generationError    String?  @db.Text
  // Subject-aware generation (Phase 10.8). Classifier-detected subject
  // buckets ranked by weight; the generator restricts question kinds to
  // each subject's palette. Empty arrays mean the row predates the
  // feature — the orchestrator treats this as `['general']` with weight 1.
  subjects           String[] @default([])
  subjectWeights     Float[]  @default([])
  // Ultra path = quizzes generated with the premium model (Pro-only,
  // quota-limited). Persisted because Stage B runs detached and reloads
  // the plan from this row.
  ultra              Boolean  @default(false)
  // Per-path Gemini override (test toggle). When true, every stage
  // (structure / theory / flashcards / quiz) routes through Gemini
  // regardless of PATH_PROVIDER env vars OR the ultra flag. Default
  // false → behavior unchanged.
  gemini             Boolean  @default(false)
  // Content language of the path (BCP-47 lowercase). Drives the source
  // side of in-place path translation.
  language           String   @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook      StudyContainer? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  phases        StudyPhase[]
  // Back-references for FlashcardSet/QuizSet.sourcePathId — used by
  // future "Save to notebook" promote action; SetNull there so deleting
  // the path leaves the bundle behind for the notebook to claim.
  flashcardSets FlashcardSet[]  @relation("PathFlashcardSets")
  quizSets      QuizSet[]       @relation("PathQuizSets")
  concepts      Concept[]
  conceptEdges  ConceptEdge[]

  // Serves both `where userId` (leftmost prefix) and the overview/dashboard
  // `where userId orderBy updatedAt desc` — the planner can walk this backwards
  // for the sort instead of fetching + in-memory sorting the user's rows.
  @@index([userId, updatedAt(sort: Desc)])
  @@index([notebookId])
  @@index([contextNotebookIds], type: Gin)
  @@map("study_plans")
}

// ─────────── Weakness Training — Phase 1 (concept mastery) ───────────
// See plans/weakness-training.md §3. Concept tagging is closed-enum per slot;
// ConceptAttemptEvent/ConceptMastery track evidence-weighted, decayed mastery.
// No physical columns are added to QuizQuestion, QuizSet, or Flashcard —
// linkage lives in ConceptTag; remediation-only item metadata lives in
// QuizQuestion.payload (existing Json? column).

model Concept {
  id          String   @id @default(cuid())
  planId      String
  slotId      String // CheckpointSlot this concept was extracted from (closed-enum scope)
  key         String // stable slug, e.g. "regular-ar-present-tense" — unique within slot
  label       String // short display name shown in Weak Spots UI
  description String?  @db.Text // 1 sentence, seeded from the Stage A objective text
  createdAt   DateTime @default(now())

  // ── Phase 4.1 (plans/weakness-training-phase4.md §11) — canonicalization ──
  // Null = this row IS canonical. Non-null = merged INTO canonicalId — all NEW
  // writes resolve through canonicalId first; old ConceptTag/
  // ConceptAttemptEvent/ConceptMastery rows are left in place, untouched
  // (mastery is unioned at read time in concept-weak-areas-loader.ts).
  canonicalId         String?
  // Canonical row's label frozen at merge time (UI shows it without a join).
  mergedLabelSnapshot String?   @db.Text
  mergedAt            DateTime?
  // 256-dim Gemini embedding for tier-2 dedup; empty until the dedup job has
  // processed this row — empty-embedding rows ARE the backfill resume point.
  embedding           Float[]
  embeddedAt          DateTime?

  plan      StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  canonical Concept?  @relation("ConceptCanonical", fields: [canonicalId], references: [id], onDelete: SetNull)

  mergedInto Concept[]     @relation("ConceptCanonical")
  edgesFrom  ConceptEdge[] @relation("ConceptEdgeFrom")
  edgesTo    ConceptEdge[] @relation("ConceptEdgeTo")

  tags    ConceptTag[]
  events  ConceptAttemptEvent[]
  mastery ConceptMastery[]

  @@unique([slotId, key])
  @@index([planId])
  @@index([canonicalId])
  @@map("concepts")
}

model ConceptTag {
  id        String   @id @default(cuid())
  conceptId String
  itemType  String // 'quiz_question' | 'flashcard'
  itemId    String
  weight    Float    @default(1.0) // 1.0 primary, 0.5 secondary — max 2 tags per item in v1
  createdAt DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, itemType, itemId])
  @@index([itemType, itemId])
  @@map("concept_tags")
}

model ConceptAttemptEvent {
  id              String   @id @default(cuid())
  conceptId       String
  userId          String
  itemType        String
  itemId          String
  sourceAttemptId String // QuizAttempt.id or AssessmentAttempt.id — dedupe + audit key
  questionKind    String // QuestionKind value, needed to recompute chanceP if formula changes
  quality         Int // 0 | 1 | 2
  isCorrect       Boolean
  // Phase 4 (§10.3) — which pipeline produced this event. Distinguishes
  // weakness-session retests (nudge failure-streak trigger) from ordinary quiz
  // variance, and excludes flashcard self-grades from that trigger.
  origin          String   @default("general") // 'general' | 'weakness_session' | 'flashcard_review'
  createdAt       DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([sourceAttemptId, conceptId, itemId]) // hard dedupe guard — safe to replay/retry
  @@index([userId, conceptId, createdAt])
  @@map("concept_attempt_events")
}

model ConceptMastery {
  id                 String    @id @default(cuid())
  userId             String
  conceptId          String
  weightedCorrect    Float     @default(0)
  weightedTotal      Float     @default(0)
  attemptCount       Int       @default(0)
  lastAttemptAt      DateTime?
  lastCorrectAt      DateTime?
  peakLcb            Float     @default(0) // PERSISTED history: highest lcb ever reached; feeds `rusty` (§2.1.1)
  status             String    @default("untested") // DENORMALISED CACHE of the band, rewritten on every write; reads MUST re-decay (§2.1.1)
  misconceptionLabel String?   @db.Text // shipped in Phase 1 to avoid a 2nd migration on this table later
  misconceptionAt    DateTime? // last async LLM tag — enforces 7-day cooldown
  updatedAt          DateTime  @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, status])
  @@map("concept_masteries")
}

// ─────────── Weakness Training — Phase 4.2 (prerequisite DAG) ───────────
// See plans/weakness-training-phase4.md §12. Edges are within one plan only
// (application-enforced), never rewritten on concept merge — readers resolve
// endpoints through Concept.canonicalId at read time.

model ConceptEdge {
  id            String   @id @default(cuid())
  planId        String // denormalised from fromConcept.planId — scopes queries + enforces same-plan invariant cheaply
  fromConceptId String // the PREREQUISITE (upstream)
  toConceptId   String // the DEPENDENT concept — "fromConcept is a prerequisite of toConcept"
  kind          String   @default("prerequisite") // v1 only ever writes 'prerequisite'
  confidence    Float    @default(0.5) // structural_phase_order 0.35 | structural_covers_slot 0.55 | llm_stage_a 0.7
  source        String // 'structural_phase_order' | 'structural_covers_slot' | 'llm_stage_a'
  createdAt     DateTime @default(now())

  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromConcept Concept   @relation("ConceptEdgeFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConcept   Concept   @relation("ConceptEdgeTo", fields: [toConceptId], references: [id], onDelete: Cascade)

  @@unique([fromConceptId, toConceptId])
  @@index([toConceptId]) // "what are my prerequisites" — the hot read path
  @@index([planId])
  @@map("concept_edges")
}

// Weakness Training Phase 2 (plan §3, §3.2 Migration B). One generated
// remediation session. `conceptIds` is a Postgres-native ordered array (2-3
// Concept.id in delivery order); `sourcePathId`/`quizSetId` are plain ids (no
// FK — a deleted path/set simply leaves a dangling reference the read paths
// tolerate). Powers reuse-before-generate (§5.4), the per-concept cooldown
// (§5.5), and the graduated-concept achievement count (§7.3).
model WeaknessTrainingSession {
  id           String    @id @default(cuid())
  userId       String
  sourcePathId String? // StudyPlan.id the primary concept came from
  conceptIds   String[] // 2-3 Concept.id, in delivery order
  quizSetId    String? // the single generated QuizSet delivering all steps
  status       String    @default("assembling") // assembling|ready|completed|abandoned
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([userId, createdAt])
  @@map("weakness_training_sessions")
}

model StudyPhase {
  id           String       @id @default(cuid())
  planId       String
  title        String
  description  String?      @db.Text
  sortOrder    Int          @default(0)
  startDate    DateTime
  endDate      DateTime
  status       String       @default("upcoming") // "upcoming" | "active" | "completed"
  // Phase 5: governs how materials in this phase unlock and whether the phase
  // gates the next one. Legacy rows stay on `open` (no breaking change).
  // Phase 10 — only `sequential` is used by the new generator; the GateStrategy
  // enum is preserved for the schema, but path-gating treats every phase as
  // sequential going forward.
  gateStrategy GateStrategy @default(open)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  plan  StudyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  slots CheckpointSlot[]

  @@index([planId])
  @@map("study_phases")
}

// Phase 10 — a single node on the guided path. Bundles 2–4 activities
// (theory → flashcards → quiz) that the user works through inside an inline
// drawer (Phase 10.6). Replaces the old `StudyMaterial` row.
model CheckpointSlot {
  id                  String   @id @default(cuid())
  phaseId             String
  title               String
  description         String?  @db.Text
  // Stage A's measurable learning objective for this slot — the concrete,
  // testable thing the learner can do after it ("conjugate regular -ar verbs
  // in the present tense"). `description` (the topicHint) says what to TEACH;
  // `objective` says what the learner can DO, and the slot's quiz targets it.
  // Optional: legacy/Gemini rows without it fall back to the topicHint.
  objective           String?  @db.Text
  // Structured assessment blueprint emitted in the existing Stage-A call.
  // Stage B uses this instead of inferring cognitive demand from a verb alone.
  assessmentSpec      Json?
  // "learning" | "review" | "assessment". Generator picks kind from phase
  // position; the last slot of each phase is always "assessment".
  kind                String   @default("learning")
  sortOrder           Int      @default(0)
  // For review/assessment slots: the specific earlier slots in the same phase
  // this checkpoint consolidates/tests. Stage A emits section-local indices,
  // resolved to slot ids at persist time. Empty for learning slots (and for
  // the final exam, which pulls path-wide via the orchestrator). Drives the
  // richer review pool fed to Stage B content prompts.
  coversSlotIds       String[] @default([])
  // Slot-level prerequisite override. When non-empty, every listed slot id
  // must be completed before this one unlocks (in addition to the default
  // sequential gate). Phase 10.6 wires up the real logic.
  prerequisiteSlotIds String[] @default([])
  // Activity kinds Stage B intentionally PRUNED for this slot because the
  // material was too thin to support them — distinct from a generation
  // FAILURE, where the expected kind is simply absent. path-gating treats a
  // pruned kind as satisfied, so a deliberately-tight slot reads as complete
  // rather than broken. See plans/path-generation-reliability.md.
  prunedActivityKinds String[] @default([])
  // 0–3 stars, awarded by the slot's assessment activity (Phase 10.6).
  starsEarned         Int      @default(0)
  // Best percentage ever achieved on this slot's assessment. Updated by the
  // POST /api/learn/slots/[slotId]/assessment route on every attempt
  // (max-merge with prior value). Null if the slot has never been attempted.
  // Drives the letter-grade chip in PathView; pre-grading-feature rows stay
  // null and the renderer falls back to a star-derived coarser grade.
  bestPercentage      Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  phase      StudyPhase           @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  activities CheckpointActivity[]
  attempts   AssessmentAttempt[]

  @@index([phaseId])
  @@map("checkpoint_slots")
}

// Phase 10 — one step inside a checkpoint slot. Exactly one of theoryId /
// flashcardSetId / quizSetId is populated, picked by `kind`. The unique FKs
// give us a cheap back-relation so dropping a slot cascades to its content.
model CheckpointActivity {
  id             String    @id @default(cuid())
  slotId         String
  kind           String // "theory" | "flashcards" | "quiz"
  title          String
  sortOrder      Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  theoryId       String?   @unique
  flashcardSetId String?   @unique
  quizSetId      String?   @unique

  slot         CheckpointSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  theory       TheoryContent? @relation(fields: [theoryId], references: [id], onDelete: Cascade)
  flashcardSet FlashcardSet?  @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  quizSet      QuizSet?       @relation(fields: [quizSetId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@map("checkpoint_activities")
}

// Phase 10 — short-form theory rendered by a read-only TipTap viewer inside
// the checkpoint drawer (Phase 10.6). Body is TipTap JSON. Not exposed in
// the notebook tree — only reachable through its CheckpointActivity.
model TheoryContent {
  id                 String              @id @default(cuid())
  title              String
  body               Json
  // Source-highlighting feature — ONE primary grounding anchor for the lesson
  // (parity with QuizQuestion). `sourceQuote` is the passage the source viewer
  // highlights; identity is server-resolved from the corpus at generation time.
  // All nullable so legacy theory and unresolvable anchors fall back gracefully.
  sourceLabel        String? // Citation label, e.g. the document / page title
  sourcePage         Int? // 1-based source page/slide, when known
  sourceQuote        String?             @db.Text // Verbatim grounding passage to highlight
  sourceMaterialId   String? // Page.id or Document.id the quote came from
  sourceMaterialKind String? // "page" | "document"
  sourceTimestampSec Int? // video seek target (seconds)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activity           CheckpointActivity?
  images             TheoryImage[]

  @@map("theory_content")
}

// Path-owned snapshot of a source image embedded into theory (theory-visuals
// feature). The blob is COPIED at generation time (not referenced) so the
// theory survives source-page deletion, and the clone flow can deep-copy these
// rows the same way FlashcardImage is copied. The TipTap `pathImage` node
// carries only a `ref` (this row's sortOrder within the theory), never an
// id/URL — so cloning needs no body rewrite.
model TheoryImage {
  id                String   @id @default(cuid())
  theoryId          String
  sourcePageImageId String? // provenance only; nullable so source deletion can't strand us
  fileName          String
  filePath          String
  fileSize          Int
  mimeType          String
  caption           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  theory TheoryContent @relation(fields: [theoryId], references: [id], onDelete: Cascade)

  @@index([theoryId])
  @@map("theory_images")
}

// Phase 10 — replaces CheckpointAttempt. Scoped to a slot (was a phase) and
// records starsEarned (1 at 70%, 2 at 85%, 3 at 95%) instead of a binary
// `passed` flag.
model AssessmentAttempt {
  id          String   @id @default(cuid())
  slotId      String
  userId      String
  score       Int
  total       Int
  percentage  Float
  starsEarned Int
  attemptedAt DateTime @default(now())

  slot CheckpointSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slotId])
  @@map("assessment_attempts")
}

// --- Microsoft OneNote Connection ---

model MicrosoftConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("microsoft_connections")
